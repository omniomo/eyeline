{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyeline"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyeline"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyeline listens while you read, so the script moves with your voice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你念稿的时候，Eyeline 需要听着，字才能跟着你的声音走。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyeline recognizes the words you say to know where you are in the script. When your Mac supports it, this happens on your Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyeline 要认出你念的字，才知道你念到了稿子的哪里。Mac 支持的话，识别只在你的 Mac 上进行。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyeline records a take with your camera while you read, so you can check your eye contact."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "念稿的时候，Eyeline 用摄像头录下来，让你回看眼神是不是对着镜头。"
          }
        }
      }
    },
    "NSAppleEventsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyeline follows your slides in Keynote or PowerPoint, so the script jumps to the slide you are on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyeline 跟着 Keynote 或 PowerPoint 翻页，把提词条跳到你正在讲的那一页。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
